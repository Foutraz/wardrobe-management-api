includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/xefi/phpstan-xefi-rules/extension.neon

parameters:
    level: 7

    configDirectories:
        - config
        - functional/*/config
        - technical/*/config

    paths:
        - functional
        - technical
        - routes

    scanFiles:
        - faker_mixin.php

    excludePaths:
        - functional/*/database/migrations/*
        - technical/*/database/migrations/*
